# ========================================
# LOVABLE FARM - CONFIGURAÇÃO COMPLETA
# ========================================
# Copie este arquivo para .env e ajuste conforme necessário
# Comando: cp .env.example .env

# ========================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# ========================================

# URL da plataforma Lovable
LOVABLE_BASE_URL=https://lovable.dev

# Link de indicação do Usuário A (OBRIGATÓRIO - SUBSTITUA COM SEU LINK)
# Obtenha seu link em: https://lovable.dev/settings/referrals
REFERRAL_LINK=https://lovable.dev/invite/3DNDOWZ

# Template URL (opcional - usado para criar projetos)
TEMPLATE_PROJECT_URL=https://lovable.dev/dashboard/templates/websites/blog/perspective-lifestyle

# ========================================
# CONFIGURAÇÃO DE EMAIL (Inbound.new)
# ========================================

# API Key do Inbound.new (já configurada - pode usar esta ou criar sua própria)
# Para criar nova: https://inbound.new/settings/api
INBOUND_API_KEY=HfpFDyCTsdiWQPnJdsdDaxjfFkJvLfRbQkBbGQJzfZQXyUSGEpAvKuPoRamTbOVL

# Domínio do Inbound.new (já configurado)
INBOUND_DOMAIN=equipeartificial.com

# ========================================
# CONFIGURAÇÃO TOR (Bypass DNS/Bloqueios)
# ========================================
# Habilite para usar a rede Tor e contornar bloqueios
# Requer Tor instalado: sudo apt-get install tor

# Habilitar Tor? (true/false)
TOR_ENABLED=false

# Host do SOCKS proxy do Tor
TOR_SOCKS_HOST=127.0.0.1

# Porta do SOCKS proxy do Tor
TOR_SOCKS_PORT=9050

# ========================================
# CONFIGURAÇÃO DE PROXY (Opcional)
# ========================================
# Use para rotação de IP com proxies comerciais

# Habilitar proxy? (true/false)
PROXY_ENABLED=false

# URL com lista de proxies (opcional)
PROXY_LIST_URL=

# Lista de proxies separados por vírgula (opcional)
# Formato: http://user:pass@host:port,http://user:pass@host2:port
PROXY_LIST=

# ========================================
# CONFIGURAÇÕES DE EXECUÇÃO
# ========================================

# Número de usuários executando simultaneamente
# Recomendado: 3-5 para máquinas normais, 10-20 para máquinas potentes
MAX_CONCURRENT_USERS=5

# Delay entre ações (em milissegundos)
# Valores maiores = mais realista mas mais lento
DELAY_BETWEEN_ACTIONS_MS=1000

# Timeout geral (em milissegundos)
# Aumente se tiver muitos timeouts
TIMEOUT_MS=60000

# ========================================
# CONFIGURAÇÕES DO NAVEGADOR
# ========================================

# Executar navegador sem interface gráfica? (true/false)
# true = mais rápido, false = você vê o que está acontecendo
HEADLESS=true

# Desacelerar ações (em milissegundos)
# Útil para debug: 500-1000
# Produção: 0
SLOW_MO=0

# ========================================
# DEBUG E DESENVOLVIMENTO
# ========================================

# Modo debug (mais logs)
DEBUG_MODE=false

# Injetar scripts customizados (avançado)
SCRIPT_INJECTION=false

# ========================================
# EXEMPLOS DE CONFIGURAÇÕES
# ========================================

# DESENVOLVIMENTO/DEBUG:
# HEADLESS=false
# SLOW_MO=500
# DEBUG_MODE=true
# MAX_CONCURRENT_USERS=1

# PRODUÇÃO (SEM TOR):
# HEADLESS=true
# SLOW_MO=0
# DEBUG_MODE=false
# MAX_CONCURRENT_USERS=5
# TOR_ENABLED=false

# PRODUÇÃO (COM TOR):
# HEADLESS=true
# SLOW_MO=0
# DEBUG_MODE=false
# MAX_CONCURRENT_USERS=3
# TOR_ENABLED=true
# TIMEOUT_MS=90000

# TESTE EM ESCALA:
# HEADLESS=true
# MAX_CONCURRENT_USERS=10
# PROXY_ENABLED=true
# PROXY_LIST=seus_proxies_aqui
